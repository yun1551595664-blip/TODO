# Production deployment template. Copy to .env on the server and replace every CHANGE_ME value.

BACKEND_PORT=8080
FRONTEND_PORT=18000
MYSQL_PORT=3306

DB_NAME=issue_ops
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD

DOCKER_DNS_PRIMARY=223.5.5.5
DOCKER_DNS_SECONDARY=114.114.114.114

AUTH_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARS
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_USERS=admin|CHANGE_ME_ADMIN_PASSWORD|ADMIN|照远|全部|ALL
AUTH_SSO_ENABLED=false
AUTH_SSO_PROVIDER_NAME=企业 SSO
AUTH_SSO_LOGIN_URL=
AUTH_SSO_CALLBACK_SECRET=
AUTH_SSO_AUTO_PROVISION=true
AUTH_SSO_DEFAULT_ROLE=VIEWER
AUTH_SSO_DEFAULT_DATA_SCOPE=DEPARTMENT

ORG_DEPARTMENTS=全部,产品部,技术部,客服部,管理部
AI_PROVIDER=deepseek
AI_API_KEY=CHANGE_ME_AI_API_KEY
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro
AI_TIMEOUT_MS=60000
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2000

# Backward-compatible DeepSeek variables. Prefer AI_* for new deployments.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
